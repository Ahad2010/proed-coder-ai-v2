# === Database ===
DATABASE_URL="postgresql://proed:proed_dev@localhost:5432/proed_coder_ai?schema=public"

# === LLM Provider ===
# "groq"      → free tier, default for MVP dev
# "anthropic" → paid, swap in for production once ProEd is live
LLM_PROVIDER="groq"

# --- Groq (free tier, https://console.groq.com) ---
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Anthropic (paid, for production) ---
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-sonnet-4-5-20250929"

# === Embeddings Provider ===
# "xenova" → free, runs locally via @huggingface/transformers (default for MVP)
# "openai" → paid, use in production for higher throughput
EMBEDDING_PROVIDER="xenova"

# --- Xenova / HuggingFace (free, local, no key needed) ---
# First run downloads the model (~130MB) into node_modules cache.
XENOVA_EMBEDDING_MODEL="Xenova/bge-small-en-v1.5"

# --- OpenAI (paid, only if EMBEDDING_PROVIDER="openai") ---
# text-embedding-3-small supports `dimensions=384` to match Xenova output.
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# === Auth (NextAuth v5) ===
AUTH_SECRET="run-openssl-rand-base64-32-to-generate"
AUTH_URL="http://localhost:3000"

# Email provider for magic links (optional in Phase 1)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_..."
EMAIL_FROM="noreply@proedcs.com"

# === App ===
NODE_ENV="development"
